# Client-Side Configuration (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ADMIN_EMAIL=admin@medical360.com

# Canonical production origin (SEO: canonical links, Open Graph, JSON-LD, sitemap)
VITE_SITE_URL=https://www.med360.mu

# 24/7 WhatsApp consultation hotline (international format, no +)
VITE_WHATSAPP_PHONE=23059188275

# Platform Maintenance Mode (true/false) - defaults to false (LIVE)
VITE_MAINTENANCE_MODE=false

# Email Integration — SERVER-SIDE ONLY. NEVER prefix with VITE_ (it would be bundled into public JS).
# Production: set RESEND_API_KEY as a Vercel Environment Variable for /api/resend/emails.
# Local dev: the Vite dev middleware reads RESEND_API_KEY from your untracked .env.
RESEND_API_KEY=re_your_resend_api_key_here

# WhatsApp Cloud API webhook verification token (Vercel Environment Variable)
WHATSAPP_VERIFY_TOKEN=choose-a-strong-random-token


