# =============================================================================
# Med360 Environment Configuration (.env.example)
# Copy to .env for local development. Never commit .env or .neon.
# =============================================================================

# Primary Backend — Neon Lakebase Postgres (Default)
# Provisioned via `neon init` + `neon deploy` (see neon.ts)
VITE_NEON_DATA_API_URL=https://your-neon-branch.apirest.aws.neon.tech/neondb/rest/v1
VITE_NEON_AUTH_URL=https://your-neon-branch.neonauth.aws.neon.tech/neondb/auth

# Direct Postgres connection string — SERVER-SIDE / CLI SCRIPTS ONLY (never prefix with VITE_)
DATABASE_URL=postgresql://user:password@your-neon-host.aws.neon.tech/neondb?sslmode=require

# Optional Fallback Backend — Supabase (selectable in Admin Settings)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin & Notifications
VITE_ADMIN_EMAIL=info@med360.mu

# Canonical Production Origin (SEO: canonical links, Open Graph, JSON-LD, sitemap)
VITE_SITE_URL=https://www.med360.mu

# 24/7 WhatsApp Consultation Hotline (international format, no +)
VITE_WHATSAPP_PHONE=23059188275

# Platform Maintenance Mode (true/false) - defaults to false (LIVE)
VITE_MAINTENANCE_MODE=false

# Email Integration — SERVER-SIDE ONLY. NEVER prefix with VITE_.
# Production: set RESEND_API_KEY as a Vercel Environment Variable for /api/resend/emails.
# Local dev: the Vite dev middleware reads RESEND_API_KEY from your untracked .env.
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Resend sender address (required for external patient/campaign emails in production)
VITE_RESEND_FROM=Med360 <notifications@med360.mu>

# WhatsApp Cloud API webhook verification token (Vercel Environment Variable)
WHATSAPP_VERIFY_TOKEN=choose-a-strong-random-token
