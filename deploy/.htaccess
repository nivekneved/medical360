# ============================================================================
# Med360 — Apache Configuration (PORTABILITY FALLBACK)
# ----------------------------------------------------------------------------
# Production hosting is Vercel — security headers, redirects and SPA routing
# are configured in /vercel.json. THIS FILE exists so the exact same build can
# be dropped onto any Apache/cPanel host with identical behaviour.
# Place it in the web root (next to index.html) if self-hosting.
# ============================================================================

# ── Force HTTPS + canonical www host ─────────────────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.med360\.mu$ [NC]
RewriteRule ^(.*)$ https://www.med360.mu/$1 [R=301,L]

# ── Single Page Application fallback (all non-file routes -> index.html) ────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^ /index.html [L]

# ── Legacy URL 301 redirects (match vercel.json) ─────────────────────────────
Redirect 301 /doctors       /
Redirect 301 /services      /how-it-works
Redirect 301 /visa-guide    /how-it-works

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.resend.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

  # Never cache HTML (SPA shell); cache hashed assets for 1 year
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ── Deny secrets & dotfiles ──────────────────────────────────────────────────
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /index.html
